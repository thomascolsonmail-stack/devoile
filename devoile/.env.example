# URL de connexion PostgreSQL (ex: Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chaîne aléatoire longue et secrète utilisée pour signer les sessions.
# Génère-la avec: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Optionnel : token Vercel Blob pour stocker les photos/vidéos en production.
# Sans cette variable, les fichiers sont stockés dans /public/uploads (dev local uniquement).
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_HAS_BLOB=""